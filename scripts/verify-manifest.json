  "$pathMap-doc": "WS-7.6b: `run-verifies.mjs --changed` maps `git diff` files through these ORDERED entries (first glob match wins per file; matched `run` sets union; any unmatched file falls back to tier:pure). `self` = a changed verify script runs itself. tier:presence and tier:scale entries activate as those tiers land (unknown names warn + skip).",
  "pathMap": [
    {
      "glob": "scripts/verify-*",
      "run": [
        "self",
        "tier:pure"
      ]
    },
    {
      "glob": "scripts/figenh-*",
      "run": [
        "self",
        "tier:pure"
      ]
    },
    {
      "glob": "src/shell/modes/paper/**",
      "run": [
        "group:paper-gate",
        "tier:pure"
      ]
    },
    {
      "glob": "resources/flux-context/**",
      "run": [
        "verify-context-scheme.ts"
      ]
    },
    {
      "glob": "electron/{agentsConfig,fluxContextDocs.gen}.cjs",
      "run": [
        "verify-context-scheme.ts",
        "verify-fluxconfig.ts"
      ]
    },
    {
      "glob": "src/lib/project/{feedback,contextTemplates,contextHeal,paperSelectionStore}.ts",
      "run": [
        "verify-feedback.ts",
        "verify-context-scheme.ts",
        "verify-scaffold.ts"
      ]
    },
    {
      "glob": "flux-core/{feedback,context,comments}.ts",
      "run": [
        "verify-feedback.ts",
        "verify-registry-parity.ts"
      ]
    },
    {
      "glob": "flux-core/agents.ts",
      "run": [
        "verify-dispatch.ts",
        "verify-principal-pty.ts",
        "verify-registry-parity.ts"
      ]
    },
    {
      "glob": "electron/agentsConfig.cjs",
      "run": [
        "verify-context-scheme.ts",
        "verify-dispatch.ts",
        "verify-principal-pty.ts"
      ]
    },
    {
      "glob": "src/shell/agent/**",
      "run": [
        "tier:pure"
      ]
    },
    {
      "glob": "src/lib/PlotElement.svelte",
      "run": [
        "tier:pure",
        "tier:scale",
        "verify-lazy-save-safety.mjs",
        "verify-lazy-load-gui.mjs",
        "verify-lazy-export-overrides.mjs"
      ]
    },
    {
      "glob": "src/lib/project/figbridge.ts",
      "run": [
        "tier:pure",
        "verify-lazy-save-safety.mjs",
        "verify-lazy-load-gui.mjs",
        "verify-lazy-export-overrides.mjs"
      ]
    },
    {
      "glob": "src/lib/plot/**",
      "run": [
        "tier:pure",
        "tier:scale",
        "verify-lazy-save-safety.mjs",
        "verify-lazy-load-gui.mjs",
        "verify-lazy-export-overrides.mjs"
      ]
    },
    {
      "glob": "src/shell/modes/slide/**",
      "run": [
        "tier:pure"
      ]
    },
    {
      "glob": "src/lib/slide/**",
      "run": [
        "tier:pure"
      ]
    },
    {
      "glob": "electron/**",
      "run": [
        "tier:presence",
        "tier:pure"
      ]
    },
    {
      "glob": "flux-core/**",
      "run": [
        "tier:pure"
      ]
    },
    {
      "glob": "scripts/**",
      "run": [
        "tier:pure"
      ]
    }
  ],
  "retryOnce": [
