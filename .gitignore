# Dependencies
node_modules
dist
dist-ssr
*.local

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store

# Packaging output (electron-builder)
release/
build/correction-runtime/

# Personal planning/spec docs — kept local, never published
notes/

# Defensive: fluxplot is its own repo at ~/fluxplot — ignore if ever re-cloned here
fluxplot/

# TypeScript incremental build info (from `tsc -p` on composite configs)
*.tsbuildinfo

# Screenshot artifacts from scripts/verify-*.mjs runs
test-results/

# Quarto render output for the user docs (docs/ is a Quarto website project)
docs/_site/
docs/.quarto/

flux_figure_upgrades_fixes/

default_conventions/

# Lighttable sidecar build artifacts (it also carries its own .gitignore for
# when it is lifted to its own repo; thumb cache lives in userData, not here)
lighttable/node_modules/
lighttable/dist/
lighttable/test/
# Built by `npm run build`, so a checkout always has a current one to load unpacked.
extension/dist/
# The SIGNED add-on IS committed. Only the maintainer holds AMO credentials, so a Firefox
# user running Flux from a checkout has no other way to obtain one — and Firefox will not
# permanently install an unsigned add-on. Exactly one .xpi is kept (sign:extension deletes
# the previous), and verify-extension proves its contents match the current source.
extension/signed/*
!extension/signed/*.xpi
