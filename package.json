{
  "name": "flux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "Flux — a local app for joining plots into figures, figures into papers, and slides",
  "author": {
    "name": "Kort Driessen",
    "email": "sleepanimal@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/kortdriessen/flux",
  "bin": {
    "flux": "flux-cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "flux": "tsx flux-cli.ts",
    "flux:mcp": "tsx flux-mcp.ts",
    "electron:dev": "concurrently -k -n vite,electron \"npm run dev\" \"wait-on tcp:127.0.0.1:1420 && VITE_DEV_SERVER_URL=http://127.0.0.1:1420 electron .\"",
    "electron:build": "vite build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@citation-js/core": "^0.7.21",
    "@citation-js/plugin-bibtex": "^0.7.21",
    "@citation-js/plugin-csl": "^0.7.22",
    "@citation-js/plugin-doi": "^0.7.21",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.3",
    "@floating-ui/dom": "^1.7.6",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.6.4",
    "@lydell/node-pty": "^1.1.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@resvg/resvg-js": "^2.6.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "approx-string-match": "^2.0.0",
    "chokidar": "^5.0.0",
    "dompurify": "^3.4.11",
    "js-yaml": "^5.2.0",
    "katex": "^0.16.47",
    "linkedom": "^0.18.12",
    "markdown-it": "^14.2.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-deflist": "^3.0.1",
    "markdown-it-footnote": "^4.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.1.2",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "puppeteer-core": "^25.2.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tslib": "^2.8.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "wait-on": "^8.0.0"
  }
}
